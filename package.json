{
  "name": "formulaflash-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Flashcards where the answer can be a real equation",
  "scripts": {
    "dev": "pnpm --filter app run dev",
    "build": "pnpm --filter app run build",
    "android:apk": "node scripts/build-apk.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:smoke": "playwright test --project=desktop-chrome --grep=@smoke",
    "test:matrix": "playwright test --project=desktop-chrome --grep=@matrix",
    "test:soak": "playwright test --project=desktop-chrome --grep=@soak",
    "report:matrix": "node scripts/generate-matrix-report.mjs",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "axe-core": "^4.14.0",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^8.0.0",
    "fast-check": "^4.10.2",
    "pdfjs-dist": "^6.5.438",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "DontKwo",
  "license": "GPL-3.0-or-later",
  "publisher": "DontKwo"
}
