{
  "name": "formulaflash-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "Flashcards where the answer can be a real equation",
  "scripts": {
    "dev": "pnpm --filter app run dev",
    "build": "pnpm --filter app run build",
    "android:apk": "node scripts/build-apk.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:matrix": "tsx tests/matrix/runner.ts",
    "test:matrix:smoke": "tsx tests/matrix/runner.ts --smoke",
    "typecheck": "pnpm -r exec tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "dependency-cruiser": "^16.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
